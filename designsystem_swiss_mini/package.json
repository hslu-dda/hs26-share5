{
  "name": "designsystem-mini",
  "version": "1.0.0",
  "private": true,
  "description": "Mini-Boilerplate: Tailwind + Swiss Confederation Designsystem (Fokus: responsive Layout, ohne p5.js/Daten)",
  "scripts": {
    "build-css": "postcss css/main.postcss --ext css --dir dist",
    "watch-css": "postcss css/main.postcss --ext css --dir dist --watch",
    "dev": "npm run watch-css"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.0.6",
    "postcss": "^8.4.47",
    "postcss-cli": "^8.3.1",
    "postcss-import": "^14.1.0",
    "tailwindcss": "^3.4.14"
  }
}
